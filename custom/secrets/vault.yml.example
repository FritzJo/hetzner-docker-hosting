# Copy this file to custom/secrets/vault.yml and set strong values.
# WARNING: custom/secrets/vault.yml is gitignored — do NOT commit it.
#
# For stronger protection, encrypt it with Ansible Vault:
#   ansible-vault encrypt custom/secrets/vault.yml
# then run hosting.sh with ANSIBLE_VAULT_PASSWORD_FILE pointing at a file that
# contains the vault password (never commit that file either).

# Password for the non-root sudo user (use a long, random value, >= 12 chars)
user_password: "CHANGE_ME_strong_password_min_12_chars"

# Password that encrypts the Restic backup repository.
# IMPORTANT: this cannot be changed later — choose it carefully.
GCP_Backup_Password: "CHANGE_ME_strong_backup_password"
